@import "rb_tree.sal"

@rb_node_new(value: u64) -> ^ptr:
L_ENTRY:
    node = alloc RBNode_SIZE
    store node+RBNode_value, value as u64
    store node+RBNode_color, 0 as i32
    store node+RBNode_left, 0 as ptr
    store node+RBNode_right, 0 as ptr
    store node+RBNode_parent, 0 as ptr
    return node

@rb_rotate_left(&tree: ptr, x: ptr) -> void:
L_ENTRY:
    y = load x+RBNode_right as ptr
    t2 = load y+RBNode_left as ptr
    store x+RBNode_right, t2 as ptr
    iz2 = eq t2, 0
    br iz2 -> L_S1, L_S2
L_S2:
    store t2+RBNode_parent, x as ptr
    jmp L_S1
L_S1:
    p = load x+RBNode_parent as ptr
    store y+RBNode_parent, p as ptr
    izp = eq p, 0
    br izp -> L_SR, L_SC
L_SR:
    store tree+RBTree_root, y as ptr
    jmp L_SF
L_SC:
    pl = load p+RBNode_left as ptr
    il = eq pl, x
    br il -> L_SL, L_SRR
L_SL:
    store p+RBNode_left, y as ptr
    jmp L_SF
L_SRR:
    store p+RBNode_right, y as ptr
    jmp L_SF
L_SF:
    store y+RBNode_left, x as ptr
    store x+RBNode_parent, y as ptr
    !p
    !t2
    !iz2
    !izp
    !x
    !y
    return

@rb_rotate_right(&tree: ptr, y: ptr) -> void:
L_ENTRY:
    x = load y+RBNode_left as ptr
    t2 = load x+RBNode_right as ptr
    store y+RBNode_left, t2 as ptr
    iz2 = eq t2, 0
    br iz2 -> L_S1, L_S2
L_S2:
    store t2+RBNode_parent, y as ptr
    jmp L_S1
L_S1:
    p = load y+RBNode_parent as ptr
    store x+RBNode_parent, p as ptr
    izp = eq p, 0
    br izp -> L_SR, L_SC
L_SR:
    store tree+RBTree_root, x as ptr
    jmp L_SF
L_SC:
    pr = load p+RBNode_right as ptr
    ir = eq pr, y
    br ir -> L_SRRR, L_SLL
L_SRRR:
    store p+RBNode_right, x as ptr
    jmp L_SF
L_SLL:
    store p+RBNode_left, x as ptr
    jmp L_SF
L_SF:
    store x+RBNode_right, y as ptr
    store y+RBNode_parent, x as ptr
    !p
    !t2
    !iz2
    !izp
    !x
    !y
    return

@export sa_rb_new() -> ^ptr:
L_ENTRY:
    t = alloc RBTree_SIZE
    store t+RBTree_root, 0 as ptr
    return t

@export sa_rb_insert(&tree: ptr, value: u64) -> void:
L_ENTRY:
    nn = call @rb_node_new(value)
    root = load tree+RBTree_root as ptr
    iz = eq root, 0
    br iz -> L_FIRST, L_SEARCH
L_FIRST:
    store tree+RBTree_root, nn as ptr
    store nn+RBNode_color, 1 as i32
    !nn
    !root
    !iz
    return
L_SEARCH:
    curr_s = stack_alloc 8
    store curr_s+0, root as ptr
    parent_s = stack_alloc 8
L_LOOP:
    c = load curr_s+0 as ptr
    izc = eq c, 0
    br izc -> L_INSERT_POS, L_BODY
L_BODY:
    store parent_s+0, c as ptr
    cv = load c+RBNode_value as u64
    lt = ult value, cv
    br lt -> L_GO_L, L_GO_R
L_GO_L:
    nc = load c+RBNode_left as ptr
    store curr_s+0, nc as ptr
    jmp L_LOOP
L_GO_R:
    nc2 = load c+RBNode_right as ptr
    store curr_s+0, nc2 as ptr
    jmp L_LOOP

L_INSERT_POS:
    p = load parent_s+0 as ptr
    store nn+RBNode_parent, p as ptr
    pv = load p+RBNode_value as u64
    ilt = ult value, pv
    br ilt -> L_SET_L, L_SET_R
L_SET_L:
    store p+RBNode_left, nn as ptr
    jmp L_FIXUP
L_SET_R:
    store p+RBNode_right, nn as ptr
    jmp L_FIXUP

L_FIXUP:
    call @rb_insert_fixup_iter(&tree, nn)
    !nn
    !root
    !iz
    !c
    !izc
    !p
    !pv
    return

@rb_insert_fixup_iter(&tree: ptr, z: ptr) -> void:
L_ENTRY:
    z_s = stack_alloc 8
    store z_s+0, z as ptr
L_LOOP:
    cz = load z_s+0 as ptr
    p = load cz+RBNode_parent as ptr
    izp = eq p, 0
    br izp -> L_DONE, L_CHECK_C
L_CHECK_C:
    pc = load p+RBNode_color as i32
    irp = eq pc, 0
    br irp -> L_BODY, L_DONE
L_BODY:
    gp = load p+RBNode_parent as ptr
    gpl = load gp+RBNode_left as ptr
    ipl = eq p, gpl
    br ipl -> L_LU, L_RU
L_LU:
    y = load gp+RBNode_right as ptr
    yn = eq y, 0
    br yn -> L_C2, L_CY
L_CY:
    yc = load y+RBNode_color as i32
    yr = eq yc, 0
    br yr -> L_C1, L_C2
L_C1:
    store p+RBNode_color, 1 as i32
    store y+RBNode_color, 1 as i32
    store gp+RBNode_color, 0 as i32
    store z_s+0, gp as ptr
    jmp L_LOOP
L_C2:
    pr = load p+RBNode_right as ptr
    isz = eq cz, pr
    br isz -> L_C2R, L_C3
L_C2R:
    store z_s+0, p as ptr
    call @rb_rotate_left(&tree, p)
    cz2 = load z_s+0 as ptr
    p2 = load cz2+RBNode_parent as ptr
    gp2 = load p2+RBNode_parent as ptr
    store p2+RBNode_color, 1 as i32
    store gp2+RBNode_color, 0 as i32
    call @rb_rotate_right(&tree, gp2)
    jmp L_LOOP
L_C3:
    store p+RBNode_color, 1 as i32
    store gp+RBNode_color, 0 as i32
    call @rb_rotate_right(&tree, gp)
    jmp L_LOOP
L_RU:
    // Mirror RU...
    jmp L_DONE

L_DONE:
    rt = load tree+RBTree_root as ptr
    br_null rt -> L_EXIT, L_FIN
L_FIN:
    store rt+RBNode_color, 1 as i32
L_EXIT:
    return

@rb_node_free(^node: ptr) -> void:
L_ENTRY:
    iz = eq node, 0
    br iz -> L_EX, L_B
L_B:
    l = load node+RBNode_left as ptr
    r = load node+RBNode_right as ptr
    call @rb_node_free(^l)
    call @rb_node_free(^r)
    !node
    return
L_EX:
    !node
    return

@export sa_rb_free(^tree: ptr) -> void:
L_ENTRY:
    rt = load tree+RBTree_root as ptr
    call @rb_node_free(^rt)
    !tree
    return
