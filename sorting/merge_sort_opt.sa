@import "sa_std/core/mem.sa"
@import "sa_std/core/slice.sal"

@copy_segment_internal(dst: ptr, src: ptr, i: u64, end: u64) -> void:
L_ENTRY:
    done = eq i, end
    br done -> L_DONE, L_BODY
L_BODY:
    eight = 8 as u64
    off = mul i, eight
    sp = ptr_add src, off
    v = load sp+0 as u64
    dp = ptr_add dst, off
    store dp+0, v as u64
    next_i = add i, 1
    call @copy_segment_internal(dst, src, next_i, end)
    !eight
    !off
    !sp
    !v
    !dp
    !next_i
    return
L_DONE:
    !done
    return

@merge_segments_internal(dst: ptr, src: ptr, i: u64, mid: u64, j: u64, right: u64, k: u64) -> void:
L_ENTRY:
    c1 = ult i, mid
    c2 = ult j, right
    c = and c1, c2
    br c -> L_COMPARE, L_FINISH
L_COMPARE:
    eight = 8 as u64
    off_i = mul i, eight
    pi = ptr_add src, off_i
    vi = load pi+0 as u64
    off_j = mul j, eight
    pj = ptr_add src, off_j
    vj = load pj+0 as u64
    off_k = mul k, eight
    pk = ptr_add dst, off_k
    
    is_le = ule vi, vj
    br is_le -> L_PICK_I, L_PICK_J
L_PICK_I:
    store pk+0, vi as u64
    ni = add i, 1
    nk = add k, 1
    call @merge_segments_internal(dst, src, ni, mid, j, right, nk)
    !eight
    !off_i
    !pi
    !vi
    !off_j
    !pj
    !vj
    !off_k
    !pk
    !ni
    !nk
    jmp L_RET
L_PICK_J:
    store pk+0, vj as u64
    nj = add j, 1
    nk2 = add k, 1
    call @merge_segments_internal(dst, src, i, mid, nj, right, nk2)
    !eight
    !off_i
    !pi
    !vi
    !off_j
    !pj
    !vj
    !off_k
    !pk
    !nj
    !nk2
    jmp L_RET
L_FINISH:
    br c1 -> L_REM_I, L_CHECK_J
L_REM_I:
    call @copy_segment_offset(dst, src, i, mid, k)
    jmp L_RET
L_CHECK_J:
    br c2 -> L_REM_J, L_RET
L_REM_J:
    call @copy_segment_offset(dst, src, j, right, k)
    jmp L_RET
L_RET:
    !c
    !c1
    !c2
    !is_le
    return

@copy_segment_offset(dst: ptr, src: ptr, i: u64, end: u64, k: u64) -> void:
L_ENTRY:
    done = eq i, end
    br done -> L_DONE, L_BODY
L_BODY:
    eight = 8 as u64
    off_s = mul i, eight
    sp = ptr_add src, off_s
    v = load sp+0 as u64
    off_d = mul k, eight
    dp = ptr_add dst, off_d
    store dp+0, v as u64
    ni = add i, 1
    nk = add k, 1
    call @copy_segment_offset(dst, src, ni, end, nk)
    !eight
    !off_s
    !sp
    !v
    !off_d
    !dp
    !ni
    !nk
    return
L_DONE:
    !done
    return

@merge_pass(dst: ptr, src: ptr, start: u64, width: u64, n: u64) -> void:
L_ENTRY:
    done = uge start, n
    br done -> L_DONE, L_BODY
L_BODY:
    mid = add start, width
    is_oob_mid = uge mid, n
    br is_oob_mid -> L_COPY_ONLY, L_CALC_RIGHT
L_COPY_ONLY:
    call @copy_segment_offset(dst, src, start, n, start)
    !mid
    !is_oob_mid
    jmp L_DONE
L_CALC_RIGHT:
    two = 2 as u64
    right = add start, mul width, two
    is_oob_right = ugt right, n
    br is_oob_right -> L_CLAMP_RIGHT, L_DO_MERGE
L_CLAMP_RIGHT:
    right = n
    jmp L_DO_MERGE
L_DO_MERGE:
    call @merge_segments_internal(dst, src, start, mid, mid, right, start)
    next_start = add start, mul width, two
    call @merge_pass(dst, src, next_start, width, n)
    !mid
    !is_oob_mid
    !two
    !right
    !is_oob_right
    !next_start
    return
L_DONE:
    !done
    return

@merge_sort_bottom_up(src: ptr, dst: ptr, width: u64, n: u64) -> ptr:
L_ENTRY:
    done = uge width, n
    br done -> L_DONE, L_STEP
L_STEP:
    zero = 0 as u64
    call @merge_pass(dst, src, zero, width, n)
    two = 2 as u64
    next_width = mul width, two
    res = call @merge_sort_bottom_up(dst, src, next_width, n)
    !zero
    !two
    !next_width
    return res
L_DONE:
    !done
    return src

@export sa_merge_sort(&slice: ptr) -> void:
L_ENTRY:
    la = ptr_add slice, Slice_len
    n = load la+0 as u64
    !la
    is_small = ule n, 1
    br is_small -> L_RET, L_START
L_START:
    pa = ptr_add slice, Slice_ptr
    data = load pa+0 as ptr
    !pa
    
    eight = 8 as u64
    scratch = alloc mul n, eight
    
    one = 1 as u64
    final_ptr = call @merge_sort_bottom_up(data, scratch, one, n)
    
    is_data = eq final_ptr, data
    br is_data -> L_CLEANUP, L_COPY_BACK
L_COPY_BACK:
    zero = 0 as u64
    call @copy_segment_internal(data, final_ptr, zero, n)
    !zero
    jmp L_CLEANUP
L_CLEANUP:
    !scratch
    !final_ptr
    !one
    !eight
    !is_data
    return
L_RET:
    !is_small
    return
