@import "sa_std/core/slice.sal"

@bubble_sort_inner(&data: ptr, j: u64, limit: u64) -> void:
L_ENTRY:
    done = eq j, limit
    br done -> L_DONE, L_BODY
L_BODY:
    off_j = mul j, 8
    off_j1 = add off_j, 8
    p_j = ptr_add data, off_j
    p_j1 = ptr_add data, off_j1
    v_j = load p_j+0 as u64
    v_j1 = load p_j1+0 as u64
    
    is_gt = ugt v_j, v_j1
    br is_gt -> L_SWAP, L_NEXT
L_SWAP:
    store p_j+0, v_j1 as u64
    store p_j1+0, v_j as u64
    jmp L_NEXT
L_NEXT:
    !p_j
    !p_j1
    !v_j
    !v_j1
    !is_gt
    next_j = add j, 1
    call @bubble_sort_inner(&data, next_j, limit)
    !next_j
    !done
    return
L_DONE:
    !done
    return

@bubble_sort_outer(&data: ptr, i: u64, n: u64) -> void:
L_ENTRY:
    done = eq i, n
    br done -> L_DONE, L_BODY
L_BODY:
    limit = sub n, i
    limit = sub limit, 1
    call @bubble_sort_inner(&data, 0, limit)
    next_i = add i, 1
    call @bubble_sort_outer(&data, next_i, n)
    !next_i
    !limit
    !done
    return
L_DONE:
    !done
    return

@export sa_bubble_sort(&slice: ptr) -> void:
L_ENTRY:
    __addr = ptr_add slice, Slice_len
    n = load __addr+0 as u64
    !__addr
    is_small = ule n, 1
    br is_small -> L_DONE, L_START
L_START:
    __addr = ptr_add slice, Slice_ptr
    data = load __addr+0 as ptr
    !__addr
    call @bubble_sort_outer(&data, 0, n)
L_DONE:
    return
