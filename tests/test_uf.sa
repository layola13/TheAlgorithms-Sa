@import "../data_structures/union_find.sa"

@test "union find"():
L_ENTRY:
    u = call @sa_uf_new()
    a = call @sa_uf_make_set(&u)
    b = call @sa_uf_make_set(&u)
    call @sa_uf_union(&u, a, b)
    res = call @sa_uf_same_set(&u, a, b)
    ok = eq res, 1
    !res
    !a
    !b
    call @sa_uf_free(^u)
    br ok -> L_PASS, L_FAIL
L_PASS:
    !ok
    return
L_FAIL:
    !ok
    panic(103)
