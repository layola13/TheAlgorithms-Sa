@test "data structures sparse table"():
L_ENTRY:
    src_data = stack_alloc 40
    store src_data+0, 5 as u64
    store src_data+8, 2 as u64
    store src_data+16, 9 as u64
    store src_data+24, 1 as u64
    store src_data+32, 7 as u64
    src = stack_alloc 16
    __addr2 = ptr_add src, Slice_ptr
    store __addr2+0, src_data as ptr
    !__addr2
    __addr2 = ptr_add src, Slice_len
    store __addr2+0, 5 as u64
    !__addr2
    
    st = call @sa_sparse_table_new(&src)
    min02 = call @sa_sparse_table_query(&st, 0, 2)
    min14 = call @sa_sparse_table_query(&st, 1, 4)
    
    ok0 = eq min02, 2
    ok1 = eq min14, 1
    ok = and ok0, ok1
    
    !min02
    !min14
    !ok0
    !ok1
    br ok -> L_ST_OK, L_ST_ERR

L_ST_OK:
    call @sa_sparse_table_free(^st)
    !ok
    return

L_ST_ERR:
    call @sa_sparse_table_free(^st)
    !ok
    panic(316)

@test "data structures lazy segment tree"():
L_ENTRY:
    src_data = stack_alloc 40
    store src_data+0, 1 as u64
    store src_data+8, 2 as u64
    store src_data+16, 3 as u64
    store src_data+24, 4 as u64
    store src_data+32, 5 as u64
    src = stack_alloc 16
    __addr2 = ptr_add src, Slice_ptr
    store __addr2+0, src_data as ptr
    !__addr2
    __addr2 = ptr_add src, Slice_len
    store __addr2+0, 5 as u64
    !__addr2
    
    lst = call @sa_lazy_seg_new(&src)

    call @sa_lazy_seg_update(&lst, 1, 3, 10)
    
    sum13 = call @sa_lazy_seg_query(&lst, 1, 3)
    sum04 = call @sa_lazy_seg_query(&lst, 0, 4)
    
    ok0 = eq sum13, 39
    ok1 = eq sum04, 45
    ok = and ok0, ok1
    
    !sum13
    !sum04
    !ok0
    !ok1
    br ok -> L_LST_OK, L_LST_ERR

L_LST_OK:
    call @sa_lazy_seg_free(^lst)
    !ok
    return

L_LST_ERR:
    call @sa_lazy_seg_free(^lst)
    !ok
    panic(317)

@test "sorting heap merge sort"():
L_ENTRY:
    data1 = stack_alloc 24
    store data1+0, 3 as u64
    store data1+8, 1 as u64
    store data1+16, 2 as u64
    s1 = stack_alloc 16
    __addr2 = ptr_add s1, Slice_ptr
    store __addr2+0, data1 as ptr
    !__addr2
    __addr2 = ptr_add s1, Slice_len
    store __addr2+0, 3 as u64
    !__addr2
    
    call @sa_heap_sort(&s1)
    
    data2 = stack_alloc 24
    store data2+0, 5 as u64
    store data2+8, 4 as u64
    store data2+16, 6 as u64
    s2 = stack_alloc 16
    __addr2 = ptr_add s2, Slice_ptr
    store __addr2+0, data2 as ptr
    !__addr2
    __addr2 = ptr_add s2, Slice_len
    store __addr2+0, 3 as u64
    !__addr2
    
    call @sa_merge_sort(&s2)
    
    v1_0 = load data1+0 as u64
    v2_0 = load data2+0 as u64
    ok0 = eq v1_0, 1
    ok1 = eq v2_0, 4
    ok = and ok0, ok1
    
    !v1_0
    !v2_0
    !ok0
    !ok1
    br ok -> L_SORT_OK, L_SORT_ERR

L_SORT_OK:
    !ok
    return

L_SORT_ERR:
    !ok
    panic(318)

