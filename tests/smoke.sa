    panic(307)

@test "data structures floyd cycle"():
L_ENTRY:
    list = call @sa_linked_list_new()
    call @sa_linked_list_push_back(&list, 1)
    call @sa_linked_list_push_back(&list, 2)
    call @sa_linked_list_push_back(&list, 3)
    has0 = call @sa_has_cycle(&list)
    detect0 = call @sa_detect_cycle(&list)

    __addr = ptr_add list, LinkedList_head
    head = load __addr+0 as ptr
    !__addr
    __addr = ptr_add list, LinkedList_tail
    tail = load __addr+0 as ptr
    !__addr
    __addr2 = ptr_add tail, LinkedListNode_next
    store __addr2+0, head as ptr
    !__addr2

    has1 = call @sa_has_cycle(&list)
    detect1 = call @sa_detect_cycle(&list)

    ok0 = eq has0, 0
    ok1 = eq detect0, 0
    ok2 = eq has1, 1
    ok3 = eq detect1, 3
    pair0 = and ok0, ok1
    pair1 = and ok2, ok3
    ok = and pair0, pair1
    !has0
    !detect0
    !has1
    !detect1
    !ok0
    !ok1
    !ok2
    !ok3
    !pair0
    !pair1
    br ok -> L_FLOYD_OK, L_FLOYD_ERR

L_FLOYD_OK:
    call @sa_linked_list_free(^list)
    !ok
    return

L_FLOYD_ERR:
    call @sa_linked_list_free(^list)
    !ok
    panic(308)


@test "data structures hash table fenwick"():
L_ENTRY:
    table = call @sa_hash_table_new()
    call @sa_hash_table_insert(&table, 7, 70)
    call @sa_hash_table_insert(&table, 3, 30)
    got7 = call @sa_hash_table_get(&table, 7)
    got3 = call @sa_hash_table_get(&table, 3)
    got0 = call @sa_hash_table_get(&table, 0)
    fen = call @sa_fenwick_new(8)
    call @sa_fenwick_set(&fen, 0, 5)
    call @sa_fenwick_set(&fen, 1, 3)
    call @sa_fenwick_set(&fen, 2, 2)
    pref1 = call @sa_fenwick_prefix(&fen, 1)
    range0 = call @sa_fenwick_range(&fen, 0, 2)
    point2 = call @sa_fenwick_get(&fen, 2)
    ok0 = eq got7, 70
    ok1 = eq got3, 30
    ok2 = eq got0, 0
    ok3 = eq pref1, 8
    ok4 = eq range0, 10
    ok5 = eq point2, 2
    pair0 = and ok0, ok1
    pair1 = and ok2, ok3
    pair2 = and ok4, ok5
    ok = and pair0, pair1
    ok = and ok, pair2
    !got7
    !got3
    !got0
    !pref1
    !range0
    !point2
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !ok5
    !pair0
    !pair1
    !pair2
    br ok -> L_HT_OK, L_HT_ERR

L_HT_OK:
    !table
    !fen
    !ok
    return

L_HT_ERR:
    !table
    !fen
    !ok
    panic(303)

