@const SEG_VT_U64 = vtable { cmp = @cmp_u64_asc }

@test "data structures trie"():
L_ENTRY:
    trie = call @sa_trie_new()
    s1_data = stack_alloc 3
    store s1_data+0, 97 as u8
    store s1_data+1, 98 as u8
    store s1_data+2, 99 as u8
    s1 = stack_alloc 16
    __addr2 = ptr_add s1, Slice_ptr
    store __addr2+0, s1_data as ptr
    !__addr2
    __addr2 = ptr_add s1, Slice_len
    store __addr2+0, 3 as u64
    !__addr2
    
    call @sa_trie_insert(&trie, &s1)
    found1 = call @sa_trie_search(&trie, &s1)
    
    s2_data = stack_alloc 2
    store s2_data+0, 97 as u8
    store s2_data+1, 98 as u8
    s2 = stack_alloc 16
    __addr2 = ptr_add s2, Slice_ptr
    store __addr2+0, s2_data as ptr
    !__addr2
    __addr2 = ptr_add s2, Slice_len
    store __addr2+0, 2 as u64
    !__addr2
    
    found2 = call @sa_trie_search(&trie, &s2)
    sw2 = call @sa_trie_starts_with(&trie, &s2)
    
    ok0 = eq found1, 1
    ok1 = eq found2, 0
    ok2 = eq sw2, 1
    pair = and ok0, ok1
    ok = and pair, ok2
    
    !found1
    !found2
    !sw2
    !ok0
    !ok1
    !ok2
    !pair
    br ok -> L_TRIE_OK, L_TRIE_ERR

L_TRIE_OK:
    call @sa_trie_free(^trie)
    !ok
    return

L_TRIE_ERR:
    call @sa_trie_free(^trie)
    !ok
    panic(313)

@test "data structures avl tree"():
L_ENTRY:
    avl = call @sa_avl_new()
    call @sa_avl_insert(&avl, 10)
    call @sa_avl_insert(&avl, 20)
    call @sa_avl_insert(&avl, 30)
    
    __addr = ptr_add avl, AVL_root
    root = load __addr+0 as ptr
    !__addr
    __addr = ptr_add root, AVLNode_value
    val = load __addr+0 as u64
    !__addr
    __addr = ptr_add root, AVLNode_height
    h = load __addr+0 as i32
    !__addr
    
    ok0 = eq val, 20
    ok1 = eq h, 2
    ok = and ok0, ok1
    
    !val
    !h
    !ok0
    !ok1
    !root
    br ok -> L_AVL_OK, L_AVL_ERR

L_AVL_OK:
    call @sa_avl_free(^avl)
    !ok
    return

L_AVL_ERR:
    call @sa_avl_free(^avl)
    !ok
    panic(314)

