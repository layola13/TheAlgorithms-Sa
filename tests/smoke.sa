@test "sorting counting radix sort"():
L_ENTRY:
    data = stack_alloc 24
    store data+0, 10 as u64
    store data+8, 2 as u64
    store data+16, 5 as u64
    s = stack_alloc 16
    __addr2 = ptr_add s, Slice_ptr
    store __addr2+0, data as ptr
    !__addr2
    __addr2 = ptr_add s, Slice_len
    store __addr2+0, 3 as u64
    !__addr2
    
    call @sa_counting_sort(&s, 10)
    v0 = load data+0 as u64
    ok0 = eq v0, 2
    
    data2 = stack_alloc 24
    store data2+0, 170 as u64
    store data2+8, 45 as u64
    store data2+16, 75 as u64
    s2 = stack_alloc 16
    __addr2 = ptr_add s2, Slice_ptr
    store __addr2+0, data2 as ptr
    !__addr2
    __addr2 = ptr_add s2, Slice_len
    store __addr2+0, 3 as u64
    !__addr2
    
    call @sa_radix_sort(&s2)
    v2_0 = load data2+0 as u64
    ok1 = eq v2_0, 45
    
    ok = and ok0, ok1
    !v0
    !v2_0
    br ok -> L_SORT2_OK, L_SORT2_ERR
L_SORT2_OK:
    !ok
    return
L_SORT2_ERR:
    !ok
    panic(320)

@test "searching exp inter search"():
L_ENTRY:
    data = stack_alloc 40
    store data+0, 1 as u64
    store data+8, 2 as u64
    store data+16, 5 as u64
    store data+24, 7 as u64
    store data+32, 9 as u64
    s = stack_alloc 16
    __addr2 = ptr_add s, Slice_ptr
    store __addr2+0, data as ptr
    !__addr2
    __addr2 = ptr_add s, Slice_len
    store __addr2+0, 5 as u64
    !__addr2
    
    res1 = call @sa_exponential_search(&s, 7)
    res2 = call @sa_interpolation_search(&s, 5)
    
    ok0 = eq res1, 3
    ok1 = eq res2, 2
    ok = and ok0, ok1
    
    !res1
    !res2
    br ok -> L_S_OK, L_S_ERR
L_S_OK:
    !ok
    return
L_S_ERR:
    !ok
    panic(321)
