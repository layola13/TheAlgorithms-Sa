@const SORT_VT_U64 = vtable { cmp = @cmp_u64_asc }

@cmp_u64_asc(&lhs: ptr, &rhs: ptr) -> i32:
L_ENTRY:
    left = load lhs+0 as u64
    right = load rhs+0 as u64
    is_lt = ult left, right
    br is_lt -> L_LT, L_CHECK_GT
L_LT:
    !right
    !left
    !lhs
    !rhs
    !is_lt
    return -1
L_CHECK_GT:
    !is_lt
    is_gt = ugt left, right
    br is_gt -> L_GT, L_EQ
L_GT:
    !right
    !left
    !lhs
    !rhs
    !is_gt
    return 1
L_EQ:
    !right
    !left
    !lhs
    !rhs
    !is_gt
    return 0

@test "sorting quick sort u64"():
L_ENTRY:
    arr = alloc 40
    store arr+0, 9 as u64
    store arr+8, 2 as u64
    store arr+16, 7 as u64
    store arr+24, 1 as u64
    store arr+32, 5 as u64
    cmp_vt = &SORT_VT_U64
    EXPAND QSORT arr, 5, 8, cmp_vt
    v0 = load arr+0 as u64
    v1 = load arr+8 as u64
    v2 = load arr+16 as u64
    v3 = load arr+24 as u64
    v4 = load arr+32 as u64
    ok0 = eq v0, 1
    ok1 = eq v1, 2
    ok2 = eq v2, 5
    ok3 = eq v3, 7
    ok4 = eq v4, 9
    pair0 = and ok0, ok1
    pair1 = and ok2, ok3
    pair2 = and pair0, ok4
    ok = and pair1, pair2
    !v0
    !v1
    !v2
    !v3
    !v4
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !pair0
    !pair1
    !pair2
    br ok -> L_OK, L_ERR

L_OK:
    !cmp_vt
    !ok
    return

L_ERR:
    !ok
    panic(301)

@test "data structures stack queue heap uf"():
L_ENTRY:
    stack = call @sa_stack_new()
    call @sa_stack_push(&stack, 10)
    call @sa_stack_push(&stack, 20)
    spop = call @sa_stack_pop(&stack)
    speek = call @sa_stack_peek(&stack)
    q = call @sa_queue_new()
    call @sa_queue_enqueue(&q, 1)
    call @sa_queue_enqueue(&q, 2)
    qpop = call @sa_queue_dequeue(&q)
    qpeek = call @sa_queue_peek_front(&q)
    heap = call @sa_heap_new()
    call @sa_heap_add(&heap, 3)
    call @sa_heap_add(&heap, 7)
    htop = call @sa_heap_peek(&heap)
    uf = call @sa_uf_new()
    n0 = call @sa_uf_make_set(&uf)
    n1 = call @sa_uf_make_set(&uf)
    same0 = call @sa_uf_same_set(&uf, n0, n1)
    merged = call @sa_uf_union(&uf, n0, n1)
    same1 = call @sa_uf_same_set(&uf, n0, n1)
    ccount = call @sa_uf_count(&uf)
    ok0 = eq spop, 20
    ok1 = eq speek, 10
    ok2 = eq qpop, 1
    ok3 = eq qpeek, 2
    ok4 = eq htop, 7
    ok5 = eq same0, 0
    ok6 = eq merged, 1
    ok7 = eq same1, 1
    ok8 = eq ccount, 1
    pair0 = and ok0, ok1
    pair1 = and ok2, ok3
    pair2 = and ok4, ok5
    pair3 = and ok6, ok7
    pair4 = and pair0, pair1
    pair5 = and pair2, pair3
    ok = and pair4, pair5
    ok = and ok, ok8
    !spop
    !speek
    !qpop
    !qpeek
    !htop
    !same0
    !same1
    !merged
    !ccount
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !ok5
    !ok6
    !ok7
    !ok8
    !pair0
    !pair1
    !pair2
    !pair3
    !pair4
    !pair5
    br ok -> L_DS_OK, L_DS_ERR

L_DS_OK:
    !stack
    !q
    !heap
    !uf
    !ok
    return

L_DS_ERR:
    !stack
    !q
    !heap
    !uf
    !ok
    panic(302)

@test "data structures linked list and sll stack"():
L_ENTRY:
    list = call @sa_linked_list_new()
    call @sa_linked_list_push_back(&list, 11)
    call @sa_linked_list_push_back(&list, 22)
    call @sa_linked_list_push_front(&list, 5)
    lfront = call @sa_linked_list_front(&list)
    lback = call @sa_linked_list_back(&list)
    lpop = call @sa_linked_list_pop_front(&list)

    s = call @sa_stack_sll_new()
    call @sa_stack_sll_push(&s, 100)
    call @sa_stack_sll_push(&s, 200)
    spop = call @sa_stack_sll_pop(&s)
    speek = call @sa_stack_sll_peek(&s)

    ok0 = eq lfront, 5
    ok1 = eq lback, 22
    ok2 = eq lpop, 5
    ok3 = eq spop, 200
    ok4 = eq speek, 100
    pair0 = and ok0, ok1
    pair1 = and ok2, ok3
    ok = and pair0, pair1
    ok = and ok, ok4
    !lfront
    !lback
    !lpop
    !spop
    !speek
    !ok0
    !ok1
    !ok2
    !ok3
    !ok4
    !pair0
    !pair1
    br ok -> L_LL_OK, L_LL_ERR

L_LL_OK:
    call @sa_linked_list_free(^list)
    call @sa_stack_sll_free(^s)
    !ok
    return

L_LL_ERR:
    call @sa_linked_list_free(^list)
    call @sa_stack_sll_free(^s)
    !ok
    panic(304)

