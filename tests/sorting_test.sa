@import "sa_std/core/mem.sa"
@import "sa_std/core/slice.sal"

@import "../sorting/bubble_sort.sa"
@import "../sorting/counting_sort.sa"
@import "../sorting/heap_sort.sa"
@import "../sorting/insertion_sort.sa"
@import "../sorting/merge_sort.sa"
@import "../sorting/quick_sort.sa"
@import "../sorting/radix_sort.sa"
@import "../sorting/selection_sort.sa"

@test "bubble sort correctness"():
L_ENTRY:
    data = stack_alloc 32
    store data+0, 4 as u64
    store data+8, 1 as u64
    store data+16, 3 as u64
    store data+24, 2 as u64
    s = stack_alloc 16
    __addr2 = ptr_add s, Slice_ptr
    store __addr2+0, data as ptr
    !__addr2
    __addr2 = ptr_add s, Slice_len
    store __addr2+0, 4 as u64
    !__addr2
    
    call @sa_bubble_sort(&s)
    
    v0 = load data+0 as u64
    v1 = load data+8 as u64
    v2 = load data+16 as u64
    v3 = load data+24 as u64
    
    ok0 = eq v0, 1
    ok1 = eq v1, 2
    ok2 = eq v2, 3
    ok3 = eq v3, 4
    
    res = and ok0, ok1
    res = and res, ok2
    res = and res, ok3
    
    !v0
    !v1
    !v2
    !v3
    !ok0
    !ok1
    !ok2
    !ok3
    
    br res -> L_PASS, L_FAIL
L_PASS:
    return
L_FAIL:
    panic(201)

@test "counting sort correctness"():
L_ENTRY:
    data = stack_alloc 32
    store data+0, 4 as u64
    store data+8, 1 as u64
    store data+16, 3 as u64
    store data+24, 2 as u64
    s = stack_alloc 16
    __addr2 = ptr_add s, Slice_ptr
    store __addr2+0, data as ptr
    !__addr2
    __addr2 = ptr_add s, Slice_len
    store __addr2+0, 4 as u64
    !__addr2
    
    // counting sort takes maximum value (4) as second argument
    call @sa_counting_sort(&s, 4)
    
    v0 = load data+0 as u64
    v1 = load data+8 as u64
    v2 = load data+16 as u64
    v3 = load data+24 as u64
    
    ok0 = eq v0, 1
    ok1 = eq v1, 2
    ok2 = eq v2, 3
    ok3 = eq v3, 4
    
    res = and ok0, ok1
    res = and res, ok2
    res = and res, ok3
    
    !v0
    !v1
    !v2
    !v3
    !ok0
    !ok1
    !ok2
    !ok3
    
    br res -> L_PASS, L_FAIL
L_PASS:
    return
L_FAIL:
    panic(202)

