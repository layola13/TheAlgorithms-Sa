@import "../data_structures/stack.sa"
@import "../data_structures/queue.sa"

@test "stack"():
L_ENTRY:
    s = call @sa_stack_new()
    call @sa_stack_push(&s, 42)
    v = call @sa_stack_pop(&s)
    ok = eq v, 42
    !v
    call @sa_stack_free(^s)
    br ok -> L_PASS, L_FAIL
L_PASS:
    !ok
    return
L_FAIL:
    !ok
    panic(103)

@test "queue"():
L_ENTRY:
    q = call @sa_queue_new()
    call @sa_queue_enqueue(&q, 42)
    v = call @sa_queue_dequeue(&q)
    ok = eq v, 42
    !v
    call @sa_queue_free(^q)
    br ok -> L_PASS_Q, L_FAIL_Q
L_PASS_Q:
    !ok
    return
L_FAIL_Q:
    !ok
    panic(104)
