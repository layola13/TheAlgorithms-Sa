@import "../data_structures/skip_list.sa"
@test "skip list"():
L_ENTRY:
    sl = call @sa_skip_list_new()
    call @sa_skip_list_insert(&sl, 42)
    found = call @sa_skip_list_search(&sl, 42)
    ok = eq found, 1
    !found
    call @sa_skip_list_free(^sl)
    br ok -> L_PASS, L_FAIL
L_PASS:
    !ok
    return
L_FAIL:
    !ok
    panic(103)
