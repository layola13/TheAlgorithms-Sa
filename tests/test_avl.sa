@import "../data_structures/avl_tree.sa"
@test "avl"():
L_ENTRY:
    avl = call @sa_avl_new()
    call @sa_avl_insert(&avl, 20)
    call @sa_avl_insert(&avl, 10)
    call @sa_avl_insert(&avl, 30)
    rt = load avl+0 as ptr
    val = load rt+0 as u64
    ok = eq val, 20
    !val
    call @sa_avl_free(^avl)
    br ok -> L_PASS, L_FAIL
L_PASS:
    !ok
    return
L_FAIL:
    !ok
    panic(201)
