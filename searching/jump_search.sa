@import "sa_std/core/mem.sa"
@import "sa_std/core/slice.sal"

@jump_search_rec(data: ptr, idx: u64, n: u64, target: u64) -> i64:
L_ENTRY:
    done = eq idx, n
    br done -> L_NOT_FOUND, L_BODY
L_BODY:
    eight = 8 as u64
    off = mul idx, eight
    p = ptr_add data, off
    val = load p+0 as u64
    hit = eq val, target
    br hit -> L_FOUND, L_NEXT
L_NEXT:
    one = 1 as u64
    next_idx = add idx, one
    res = call @jump_search_rec(data, next_idx, n, target)
    !eight
    !off
    !p
    !val
    !hit
    !one
    !next_idx
    !done
    return res
L_FOUND:
    idx_i = bitcast idx as i64
    !eight
    !off
    !p
    !val
    !hit
    !done
    return idx_i
L_NOT_FOUND:
    !done
    return -1

@export sa_jump_search(&slice: ptr, target: u64) -> i64:
L_ENTRY:
    len_addr = ptr_add slice, Slice_len
    n = load len_addr+0 as u64
    !len_addr
    data_addr = ptr_add slice, Slice_ptr
    data = load data_addr+0 as ptr
    !data_addr
    zero = 0 as u64
    res = call @jump_search_rec(data, zero, n, target)
    !n
    !data
    !zero
    !target
    !slice
    return res
